# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- FAISS / embeddings ---
FAISS_INDEX_PATH=knowledge_base/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Knowledge base data files ---
KNOWLEDGE_BASE_DIR=knowledge_base
TEST_PATTERNS_FILE=knowledge_base/test_patterns.json
SECURITY_RULES_FILE=knowledge_base/security_rules.json
BOUNDARY_VALUES_FILE=knowledge_base/boundary_values.json
HISTORICAL_FEEDBACK_FILE=knowledge_base/historical_feedback.json

# --- Generated artifacts ---
GENERATED_TESTS_DIR=generated_tests
GENERATED_POSTMAN_DIR=generated_postman

# --- Storage (local JSON) ---
STORAGE_DIR=storage/data

# --- Reports ---
REPORTS_DIR=reports/output

# --- Logging ---
LOGS_DIR=logs
LOG_LEVEL=INFO

# --- External tools ---
NEWMAN_EXECUTABLE=newman

# MongoDB (preferred; when unavailable, documents are stored locally in SQLite)
MONGO_URI=
MONGO_DATABASE=api_test_generator
MONGO_DOCUMENT_COLLECTION=documents
MONGO_CHUNK_COLLECTION=document_chunks

# Ingestion / embeddings
INGESTION_CONFIG_FILE=config/ingestion_config.json
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
